{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagnosis",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "diagnosisId": {
          "type": "string",
          "format": "uuid"
        },
        "incidentId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "AVAILABLE"
        },
        "probableCause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100,
          "minItems": 1,
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "recommendedAction": {
          "type": "object",
          "properties": {
            "actionId": {
              "const": "CLEAR_PAYMENT_FAULT_AND_RETRY_ORDER"
            },
            "targetOrderId": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "actionId",
            "targetOrderId",
            "reason"
          ],
          "additionalProperties": false
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "graphCompleteness": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "diagnosisId",
        "incidentId",
        "status",
        "probableCause",
        "evidenceIds",
        "uncertainty",
        "modelId",
        "promptVersion",
        "graphCompleteness",
        "durationMs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "diagnosisId": {
          "type": "string",
          "format": "uuid"
        },
        "incidentId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "UNAVAILABLE"
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "PROVIDER_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "INVALID_OUTPUT",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "graphCompleteness": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "diagnosisId",
        "incidentId",
        "status",
        "reasonCode",
        "message",
        "graphCompleteness",
        "durationMs"
      ],
      "additionalProperties": false
    }
  ]
}
