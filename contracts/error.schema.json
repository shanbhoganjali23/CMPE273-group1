{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "retryable": {
      "type": "boolean"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "code",
    "message",
    "retryable",
    "correlationId"
  ],
  "additionalProperties": false
}
